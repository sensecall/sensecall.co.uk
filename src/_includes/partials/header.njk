<nav class="site-nav py-3 my-3" aria-label="Main navigation">
    <div class="container mx-auto px-4 md:px-8">
        <div class="flex justify-between items-center">
            <button id="mobile-menu-button" 
                    class="md:hidden p-2 text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary-light flex items-center"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="Open menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <span>Menu</span>
            </button>

            <div id="mobile-menu" 
                 class="fixed md:relative top-0 left-0 w-full h-full md:h-auto bg-white md:bg-transparent dark:bg-gray-900 md:dark:bg-transparent transform translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out md:transition-none z-50 md:z-auto"
                 >
                <button id="mobile-menu-close" 
                        class="md:hidden mt-6 ml-4 p-2 text-gray-700 dark:text-gray-300 flex items-center"
                        aria-label="Close menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    <span>Close</span>
                </button>

                <ul class="flex flex-col md:flex-row items-start md:items-center space-y-4 md:space-y-0 md:space-x-6 text-base md:text-lg p-4 md:p-0 divide-y divide-gray-200 dark:divide-gray-800 md:divide-y-0 w-full">
                    {% set navItems = [
                        { url: '/', text: 'Home', exact: true },
                        { url: '/about', text: 'About', srOnly: 'Dan Sensecall' },
                        { url: '/cv', text: 'CV' },
                        { url: '/projects', text: 'Projects' },
                        { url: '/public-sector-service-design-consultant', text: 'Consultancy' },
                        { url: '/contact', text: 'Contact' },
                        { url: '/writing', text: 'Writing' },
                        { url: '/experiments', text: 'Experiments' }
                    ] %}
                    {% set currentUrl = page.url or '' %}

                    {% for item in navItems %}
                        {% set isCurrent = (item.exact and currentUrl == item.url) or 
                           (not item.exact and currentUrl and (item.url in currentUrl)) %}
                        <li class="w-full pt-4 md:pt-0 md:w-auto">
                            <a href="{{ item.url }}"
                               class="block w-full md:inline-flex md:w-auto md:items-center min-h-[44px] md:min-h-0 px-2 py-2.5 md:px-0 md:py-0 border-l-4 md:border-l-0 md:border-b-2 md:pb-1 touch-manipulation text-gray-700 dark:text-gray-300 transition-colors duration-150 md:hover:text-primary md:hover:text-opacity-80 md:dark:hover:text-blue-300 md:dark:hover:text-opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-primary-light dark:focus-visible:ring-offset-gray-900 active:text-primary dark:active:text-blue-300
                                {{- ' border-l-transparent md:border-b-transparent' if not isCurrent -}}
                                {{- ' text-primary dark:text-white font-bold border-l-blue-500 md:border-b-blue-500 dark:border-l-blue-400 md:dark:border-b-blue-400' if isCurrent -}}
                                {{- ' experiments-link' if item.text == 'Experiments' -}}
                                {{- ' animate-bubbles' if item.text == 'Experiments' and currentUrl == '/experiments/' -}}"
                               {% if isCurrent %}aria-current="page"{% endif %}>
                                {% if item.text == 'Experiments' %}
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                {% endif %}
                                {{ item.text }}
                                {% if item.srOnly %}
                                    <span class="sr-only">{{ item.srOnly }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <a href="/settings/"
               class="settings-link inline-flex rounded-sm p-1 hover:text-primary dark:hover:text-primary-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-primary-light dark:focus-visible:ring-offset-gray-950 {{ 'text-primary dark:text-white' if page.url == '/settings/' else 'text-gray-700 dark:text-gray-300' }}"
               title="Settings: theme and typeface"
               {% if page.url == '/settings/' %}aria-current="page"{% endif %}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="sr-only">Settings</span>
            </a>
        </div>
    </div>
</nav>
