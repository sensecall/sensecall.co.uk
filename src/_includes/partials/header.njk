<nav class="site-nav py-3 my-3" aria-label="Main navigation">
    <div class="container mx-auto px-4 md:px-8">
        <div class="relative flex justify-between items-center">
            {% if page.url != '/' %}
                <a href="/"
                   class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex min-h-11 min-w-11 items-center justify-center rounded-sm focus-ring md:hidden"
                   aria-label="Dan Sensecall, home">
                    <img src="/assets/images/dan-sensecall-portrait-light-160.webp"
                         alt=""
                         width="160"
                         height="127"
                         decoding="async"
                         class="h-9 w-auto dark:hidden">
                    <img src="/assets/images/dan-sensecall-portrait-dark-160.webp"
                         alt=""
                         width="160"
                         height="143"
                         decoding="async"
                         class="hidden h-9 w-auto dark:block">
                </a>
            {% endif %}
            <button id="mobile-menu-button"
                    class="nav-text-button md:hidden"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="Open menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <span>Menu</span>
            </button>

            <div id="mobile-menu" class="mobile-menu">
                <button id="mobile-menu-close"
                        class="nav-text-button mt-6 ml-4 self-start md:hidden"
                        aria-label="Close menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    <span>Close</span>
                </button>

                <ul class="nav-list">
                    {% set currentUrl = page.url or '' %}

                    {% for item in navItems %}
                        {% set isCurrent = (item.exact and currentUrl == item.url) or 
                           (not item.exact and currentUrl and (item.url in currentUrl)) %}
                        <li class="nav-item{{ ' md:hidden lg:block' if item.tabletHide }}">
                            <a href="{{ item.url }}"
                               class="nav-link
                                {{- ' experiments-link' if item.text == 'Experiments' -}}
                                {{- ' animate-bubbles' if item.text == 'Experiments' and currentUrl == '/experiments/' -}}"
                               style="--nav-accent: var(--palette-{{ item.accent }})"
                               {% if isCurrent %}aria-current="page"{% endif %}>
                                {% if item.text == 'Experiments' %}
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                    <span class="bubble" aria-hidden="true"></span>
                                {% endif %}
                                {{ item.text }}
                                {% if item.srOnly %}
                                    <span class="sr-only">{{ item.srOnly }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <a href="/settings/"
               class="settings-link settings-page-link header-icon-button"
               title="Settings: theme and typeface"
               {% if page.url == '/settings/' %}aria-current="page"{% endif %}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="sr-only">Settings</span>
            </a>
            <button type="button"
                    id="settings-menu-button"
                    class="settings-menu-button header-icon-button"
                    aria-expanded="false"
                    aria-controls="settings-menu"
                    aria-haspopup="dialog">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="sr-only">Settings</span>
            </button>
        </div>
    </div>
</nav>

<div id="settings-menu"
     class="settings-menu"
     role="dialog"
     aria-modal="true"
     aria-labelledby="settings-menu-title"
     aria-hidden="true"
     hidden
     inert>
    <div class="settings-menu__backdrop" data-settings-dismiss></div>
    <div class="settings-menu__panel">
        <button type="button"
                id="settings-menu-close"
                class="nav-text-button mt-6 ml-4 self-start"
                aria-label="Close settings">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span>Close</span>
        </button>
        <div class="px-4 pb-8">
            <h2 id="settings-menu-title" class="sr-only">Settings</h2>
            {% set idPrefix = 'menu-' %}
            {% set settingsFormId = 'settings-menu-form' %}
            {% set settingsFormHidden = false %}
            {% include "partials/settings-form.njk" %}
        </div>
    </div>
</div>
