{
  "name": "ui-ux-ltd",
  "version": "1.0.0",
  "private": true,
  "description": "Dan Sensecall's Eleventy website",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/typography": "^0.5.20",
    "npm-run-all": "^4.1.5",
    "nunjucks": "^3.2.4",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "start": "npm-run-all -p dev:*",
    "dev:11ty": "SHOW_DRAFTS=1 eleventy --serve",
    "dev:css": "sass src/scss/main.scss:_site/css/styles.css --watch | npx tailwindcss -i _site/css/styles.css -o _site/css/styles.min.css --watch --content \"./src/**/*.{html,js,njk,md}\"",
    "build": "npm-run-all build:*",
    "build:11ty": "eleventy",
    "build:css": "sass src/scss/main.scss:_site/css/styles.css --style=compressed && npx tailwindcss -i _site/css/styles.css -o _site/css/styles.min.css --minify --content \"./_site/**/*.html\""
  }
}
